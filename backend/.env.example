PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=super_secret_jwt_random_key_change_in_production

# 1. MONGODB (Atlas Cloud o Local)
MONGODB_URI=mongodb+srv://<usuario>:<password>@cluster0.mongodb.net/smartinventory?retryWrites=true&w=majority

# 2. REDIS (Upstash, Redis Cloud o Local)
REDIS_URL=redis://default:<password>@<host>:<port>
# Opcional si usas host/port separados:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# 3. NEO4J (Neo4j AuraDB Cloud o Local)
NEO4J_URI=neo4j+s://<tu-instancia>.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=<tu-password-auradb>

# 4. PROMETHEUS
PROMETHEUS_METRICS_PATH=/metrics
