PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_SECRET=cambia_esta_clave_por_una_larga_y_aleatoria

# COUCHBASE CAPELLA (Base de datos NoSQL documental)
# Capella > tu clúster > Connect: copia la "Public Connection String"
COUCHBASE_CONNECTION_STRING=couchbases://cb.<tu-endpoint>.cloud.couchbase.com
# Capella > Settings > Cluster Access: usuario de base de datos
COUCHBASE_USERNAME=<usuario-db>
COUCHBASE_PASSWORD=<password-db>
COUCHBASE_BUCKET=smartinventory
COUCHBASE_SCOPE=inventario
# Durabilidad de las transacciones: none (plan gratuito, 1 nodo) o majority (clúster con réplicas)
COUCHBASE_TX_DURABILITY=none

# Sin las variables COUCHBASE_* la API arranca igual, con datos de ejemplo en memoria.
