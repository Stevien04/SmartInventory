-- ====================================================================
-- SmartInventory — Índices Primarios y Secundarios Globales (GSI)
-- Base de Datos: Couchbase Capella
-- Bucket: smartinventory | Scope: gestion
-- ====================================================================

-- 1. Crear índices primarios en cada colección para consultas de desarrollo
CREATE PRIMARY INDEX idx_primary_usuarios ON `smartinventory`.`gestion`.`usuarios`;
CREATE PRIMARY INDEX idx_primary_productos ON `smartinventory`.`gestion`.`productos`;
CREATE PRIMARY INDEX idx_primary_categorias ON `smartinventory`.`gestion`.`categorias`;
CREATE PRIMARY INDEX idx_primary_proveedores ON `smartinventory`.`gestion`.`proveedores`;
CREATE PRIMARY INDEX idx_primary_movimientos ON `smartinventory`.`gestion`.`movimientos`;
CREATE PRIMARY INDEX idx_primary_alertas ON `smartinventory`.`gestion`.`alertas`;

-- 2. Índices Secundarios Globales (GSI) para Búsqueda y Optimización

-- Colección usuarios: Búsqueda rápida por email único
CREATE INDEX idx_usuarios_email ON `smartinventory`.`gestion`.`usuarios`(email);

-- Colección productos: Búsqueda por código, estado, categoría y evaluación de stock
CREATE INDEX idx_productos_codigo ON `smartinventory`.`gestion`.`productos`(codigo);
CREATE INDEX idx_productos_estado_stock ON `smartinventory`.`gestion`.`productos`(estado, stockActual, stockMinimo);
CREATE INDEX idx_productos_categoria ON `smartinventory`.`gestion`.`productos`(categoriaId);
CREATE INDEX idx_productos_proveedor ON `smartinventory`.`gestion`.`productos`(proveedorId);

-- Colección movimientos: Ordenamiento cronológico y filtro por producto/operación
CREATE INDEX idx_movimientos_fecha ON `smartinventory`.`gestion`.`movimientos`(creadoEn DESC);
CREATE INDEX idx_movimientos_producto ON `smartinventory`.`gestion`.`movimientos`(productoId, creadoEn DESC);
CREATE INDEX idx_movimientos_operacionId ON `smartinventory`.`gestion`.`movimientos`(operacionId);

-- Colección alertas: Búsqueda por nivel de alerta y producto
CREATE INDEX idx_alertas_tipo_estado ON `smartinventory`.`gestion`.`alertas`(tipo, estado, creadoEn DESC);
